@page "/crashes"
@using Wumpus.Web.Services
@inject ReportViewService ReportService

<PageTitle>Errors - Wumpus</PageTitle>

<h1>All Errors</h1>

<div class="row mb-3">
    <div class="col-md-3">
        <label>Platform:</label>
        <select class="form-select" @bind="selectedPlatform">
            <option value="">All Platforms</option>
            <option value="Windows">Windows</option>
            <option value="Linux">Linux</option>
            <option value="Mac">Mac</option>
        </select>
    </div>
    <div class="col-md-3">
        <label>Game Version:</label>
        <input type="text" class="form-control" @bind="selectedVersion" placeholder="e.g., 1.0.0" />
    </div>
    <div class="col-md-2">
        <label>&nbsp;</label>
        <button class="btn btn-primary form-control" @onclick="ApplyFilters">Filter</button>
    </div>
</div>

@if (isLoading)
{
    <p><em>Loading errors...</em></p>
}
else if (errors != null && errors.Any())
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Timestamp</th>
                <th>Severity</th>
                <th>Exception Type</th>
                <th>Message</th>
                <th>Platform</th>
                <th>Version</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var error in errors)
            {
                <tr>
                    <td>@error.Timestamp.ToLocalTime().ToString("g")</td>
                    <td><span class="badge bg-danger">@error.Data.Severity</span></td>
                    <td><code>@error.Data.ExceptionType</code></td>
                    <td>@(error.Data.Message.Length > 50 ? error.Data.Message.Substring(0, 50) + "..." : error.Data.Message)</td>
                    <td>@error.Platform</td>
                    <td>@error.GameVersion</td>
                    <td><a href="/crashes/@error.Id" class="btn btn-sm btn-primary">Details</a></td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No errors found.</p>
}

@code {
    private List<Wumpus.Shared.Models.Error>? errors;
    private bool isLoading = true;
    private string? selectedPlatform;
    private string? selectedVersion;

    protected override async Task OnInitializedAsync()
    {
        await LoadErrors();
    }

    private async Task LoadErrors()
    {
        isLoading = true;
        errors = await ReportService.GetRecentErrorsAsync(100);
        isLoading = false;
    }

    private async Task ApplyFilters()
    {
        isLoading = true;
        errors = await ReportService.FilterErrorsAsync(
            platform: string.IsNullOrEmpty(selectedPlatform) ? null : selectedPlatform,
            gameVersion: string.IsNullOrEmpty(selectedVersion) ? null : selectedVersion
        );
        isLoading = false;
    }
}
