@page "/"
@using Domovoy.Web.Services
@inject ReportViewService ReportService

<PageTitle>Dashboard - Domovoy</PageTitle>

<h1>Crash Tracker Dashboard</h1>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (stats != null && recentCrashes != null)
{
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Total Errors</h5>
                    <p class="card-text display-4">@stats["TotalErrors"]</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Total Events</h5>
                    <p class="card-text display-4">@stats["TotalEvents"]</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Platforms</h5>
                    @foreach (var kvp in stats.Where(s => s.Key.StartsWith("Platform_")))
                    {
                        <div>@kvp.Key.Replace("Platform_", ""): @kvp.Value</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <h2>Recent Crashes</h2>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Timestamp</th>
                <th>Severity</th>
                <th>Platform</th>
                <th>Version</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var crash in recentCrashes)
            {
                <tr>
                    <td>@crash.Timestamp.ToLocalTime().ToString("g")</td>
                    <td><span class="badge bg-danger">@crash.Data.Severity</span></td>
                    <td>@crash.Standard.Platform</td>
                    <td>@crash.Standard.GameVersion</td>
                    <td><a href="/crashes/@crash.Id" class="btn btn-sm btn-primary">View</a></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private Dictionary<string, int>? stats;
    private List<Domovoy.Shared.Models.Error>? recentCrashes;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        stats = await ReportService.GetReportStatisticsAsync();
        recentCrashes = await ReportService.GetRecentErrorsAsync(10);
        isLoading = false;
    }
}
