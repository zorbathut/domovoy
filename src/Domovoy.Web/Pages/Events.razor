@page "/events"
@using Domovoy.Web.Services
@inject ReportViewService ReportService

<PageTitle>Events - Domovoy</PageTitle>

<h1>All Events</h1>

<div class="row mb-3 g-2">
    <div class="col-md-2">
        <label>Category:</label>
        <input type="text" class="form-control" @bind="selectedCategory" placeholder="e.g., Gameplay" />
    </div>
    <div class="col-md-2">
        <label>Platform:</label>
        <input type="text" class="form-control" @bind="selectedPlatform" placeholder="e.g., Windows" />
    </div>
    <div class="col-md-2">
        <label>Version:</label>
        <input type="text" class="form-control" @bind="selectedVersion" placeholder="e.g., 1.0.0" />
    </div>
    <div class="col-md-2">
        <label>Environment:</label>
        <input type="text" class="form-control" @bind="selectedEnvironment" placeholder="e.g., Dev" />
    </div>
    <div class="col-md-2">
        <label>From (UTC):</label>
        <input type="datetime-local" class="form-control" @bind="startDate" />
    </div>
    <div class="col-md-2">
        <label>To (UTC):</label>
        <input type="datetime-local" class="form-control" @bind="endDate" />
    </div>
</div>
<div class="mb-3">
    <button class="btn btn-primary" @onclick="ApplyFilters">Filter</button>
    <button class="btn btn-outline-secondary" @onclick="ClearFilters">Clear</button>
</div>

@if (isLoading)
{
    <p><em>Loading events...</em></p>
}
else if (page != null && page.Items.Count > 0)
{
    <EventsTable Items="page.Items" />
    <Pager CurrentPage="currentPage" PageSize="pageSize" TotalCount="page.TotalCount" OnPageChange="OnPageChange" />
}
else
{
    <p>No events found.</p>
}

@code {
    private const int pageSize = 50;

    private PagedResult<Event>? page;
    private bool isLoading = true;
    private int currentPage = 1;

    private string? selectedCategory;
    private string? selectedPlatform;
    private string? selectedVersion;
    private string? selectedEnvironment;
    private DateTime? startDate;
    private DateTime? endDate;

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        isLoading = true;
        page = await ReportService.GetEventsPageAsync(
            page: currentPage,
            pageSize: pageSize,
            category: string.IsNullOrEmpty(selectedCategory) ? null : selectedCategory,
            platform: string.IsNullOrEmpty(selectedPlatform) ? null : selectedPlatform,
            version: string.IsNullOrEmpty(selectedVersion) ? null : selectedVersion,
            environment: string.IsNullOrEmpty(selectedEnvironment) ? null : selectedEnvironment,
            startDate: startDate,
            endDate: endDate
        );
        isLoading = false;
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await Load();
    }

    private async Task ClearFilters()
    {
        selectedCategory = null;
        selectedPlatform = null;
        selectedVersion = null;
        selectedEnvironment = null;
        startDate = null;
        endDate = null;
        currentPage = 1;
        await Load();
    }

    private async Task OnPageChange(int newPage)
    {
        currentPage = newPage;
        await Load();
    }
}
