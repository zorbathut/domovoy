@page "/crashes/{CrashId:guid}"
@using Domovoy.Web.Services
@inject ReportViewService ReportService

<ReportDetailLayout
    PageTitle="Error Detail - Domovoy"
    Heading="Error Report Details"
    BackUrl="/crashes"
    IdLabel="Error ID"
    IsLoading="isLoading"
    LoadingMessage="Loading error details..."
    Report="error"
    Attachments="attachments"
    NotFoundHeading="Error Report Not Found"
    NotFoundMessage="The requested error report could not be found.">
    <OverviewExtras>
        <dt class="col-sm-4">Severity:</dt>
        <dd class="col-sm-8"><span class="badge bg-danger">@error!.Severity</span></dd>
    </OverviewExtras>
    <ChildContent>
        <div class="card mb-3">
            <div class="card-header"><h5>Error Message</h5></div>
            <div class="card-body">
                <p class="font-monospace">@error!.Message</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(error.StackTrace))
        {
            <div class="card mb-3">
                <div class="card-header"><h5>Stack Trace</h5></div>
                <div class="card-body">
                    <div class="bg-dark text-light p-3 font-monospace" style="font-size: 0.875em;">
                        @foreach (var line in error.StackTrace.Split('\n'))
                        {
                            <div style="white-space: pre-wrap; word-wrap: break-word; text-indent: hanging 3em;">@line</div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(error.Log))
        {
            <div class="card mb-3">
                <div class="card-header"><h5>Log</h5></div>
                <div class="card-body">
                    <div class="bg-dark text-light p-3 font-monospace" style="font-size: 0.875em;">
                        @foreach (var line in error.Log.Split('\n'))
                        {
                            <div style="white-space: pre-wrap; word-wrap: break-word; text-indent: hanging 3em;">@line</div>
                        }
                    </div>
                </div>
            </div>
        }
    </ChildContent>
</ReportDetailLayout>

@code {
    [Parameter]
    public Guid CrashId { get; set; }

    private Domovoy.Shared.Models.Error? error;
    private List<Attachment>? attachments;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        error = await ReportService.GetErrorByIdAsync(CrashId);
        if (error != null)
        {
            attachments = await ReportService.GetAttachmentsByReportIdAsync(CrashId);
        }
        isLoading = false;
    }
}
