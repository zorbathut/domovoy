@page "/crashes/{CrashId:guid}"
@using Domovoy.Web.Services
@inject ReportViewService ReportService
@inject NavigationManager Navigation

<PageTitle>Error Detail - Domovoy</PageTitle>

@if (isLoading)
{
    <p><em>Loading error details...</em></p>
}
else if (error != null)
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Error Report Details</h1>
        <button class="btn btn-secondary" @onclick="GoBack">Back to List</button>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">
                    <h5>Overview</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Error ID:</dt>
                        <dd class="col-sm-8"><code>@error.Id</code></dd>

                        <dt class="col-sm-4">Severity:</dt>
                        <dd class="col-sm-8"><span class="badge bg-danger">@error.Data.Severity</span></dd>

                        <dt class="col-sm-4">Platform:</dt>
                        <dd class="col-sm-8">@error.Standard.Platform</dd>

                        <dt class="col-sm-4">Game Version:</dt>
                        <dd class="col-sm-8">@error.Standard.GameVersion</dd>

                        <dt class="col-sm-4">Environment:</dt>
                        <dd class="col-sm-8">@error.Standard.Environment</dd>

                        <dt class="col-sm-4">Timestamp:</dt>
                        <dd class="col-sm-8"><LocalTimestamp Value="@error.Timestamp" /></dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">
                    <h5>Identifiers</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">User ID:</dt>
                        <dd class="col-sm-8"><code>@error.Standard.UserId</code></dd>

                        <dt class="col-sm-4">Computer ID:</dt>
                        <dd class="col-sm-8"><code>@error.Standard.ComputerId</code></dd>

                        <dt class="col-sm-4">Game ID:</dt>
                        <dd class="col-sm-8"><code>@error.Standard.GameId</code></dd>

                        <dt class="col-sm-4">Game Sequence IDs:</dt>
                        <dd class="col-sm-8">
                            @foreach (var id in error.Standard.GameSequenceIds)
                            {
                                <code>@id</code><br />
                            }
                        </dd>

                        <dt class="col-sm-4">Process ID:</dt>
                        <dd class="col-sm-8"><code>@error.Standard.ProcessId</code></dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h5>Error Message</h5>
        </div>
        <div class="card-body">
            <p class="font-monospace">@error.Data.Message</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(error.Data.StackTrace))
    {
        <div class="card mb-3">
            <div class="card-header">
                <h5>Stack Trace</h5>
            </div>
            <div class="card-body">
                <pre class="bg-dark text-light p-3" style="overflow-x: auto;">@error.Data.StackTrace</pre>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(error.Data.Log))
    {
        <div class="card mb-3">
            <div class="card-header">
                <h5>Log</h5>
            </div>
            <div class="card-body">
                <pre class="bg-dark text-light p-3" style="overflow-x: auto;">@error.Data.Log</pre>
            </div>
        </div>
    }

    @if (attachments != null && attachments.Count > 0)
    {
        <div class="card">
            <div class="card-header">
                <h5>Attachments</h5>
            </div>
            <div class="card-body">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Filename</th>
                            <th>Type</th>
                            <th>Size</th>
                            <th>Uploaded</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var attachment in attachments)
                        {
                            <tr>
                                <td>@attachment.Filename</td>
                                <td>@attachment.ContentType</td>
                                <td>@FormatFileSize(attachment.SizeBytes)</td>
                                <td><LocalTimestamp Value="@attachment.CreatedAt" /></td>
                                <td><a href="/api/attachments/@attachment.Id/download" class="btn btn-sm btn-outline-primary">Download</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-warning">
        <h4>Error Report Not Found</h4>
        <p>The requested error report could not be found.</p>
        <button class="btn btn-primary" @onclick="GoBack">Go Back</button>
    </div>
}

@code {
    [Parameter]
    public Guid CrashId { get; set; }

    private Domovoy.Shared.Models.Error? error;
    private List<Domovoy.Shared.Models.Attachment>? attachments;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        error = await ReportService.GetErrorByIdAsync(CrashId);
        if (error != null)
        {
            attachments = await ReportService.GetAttachmentsByReportIdAsync(CrashId);
        }
        isLoading = false;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/crashes");
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }
}
